# Copy to .env and fill in. In development everything works without provider
# credentials (mock payments, mock KYC, mock SMS). In production the server
# REFUSES to start unless the required variables below are set properly.

# ── Core ─────────────────────────────────────────────────────────────────────
# Port for the API + production server.
PORT=8787
# development | production. "production" enables the fail-fast checks below.
NODE_ENV=development
# Public base URL of the APP AS A BROWSER SEES IT. Used for checkout redirects,
# the CSRF origin check, the Sumsub WebSDK applicationUrl claim, and (baked in at
# build time) the absolute origin of the social-preview tags. In a split deploy
# (Vercel frontend, Railway API) this is the FRONTEND origin, not the API host.
# In production this MUST be https://.
APP_URL=http://localhost:8787
# Optional, build-time only: overrides APP_URL for the frontend bundle when the
# SPA is served from yet another origin. Unset is correct on Vercel, which
# reports its own production domain to the build.
VITE_APP_URL=
# SQLite file. Point it at a persistent disk in production (e.g. /data/buymepap.db).
PAP_DB_PATH=

# ── Sessions (REQUIRED in production) ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production requires >= 32 chars; without it the server refuses to start.
JWT_SECRET=
SESSION_TTL_SECONDS=2592000
# Keep COOKIE_SECURE=true in production (server enforces this).
COOKIE_SECURE=
# Extra origins allowed to POST here, comma-separated and WITH the scheme
# (https://app.example.com). A Vercel rewrite to this server keeps the browser
# same-origin, so APP_URL alone covers it — leave this empty unless a second
# frontend origin (a custom domain alongside the default one) must also post.
ALLOWED_ORIGINS=

# ── Money (integers only; 1 NGN = 100 kobo) ─────────────────────────────────
# Platform fee in basis points (0 = you keep 100% at launch; 500 = 5%).
PLATFORM_FEE_BASIS_POINTS=0
MIN_SUPPORT_KOBO=100
MAX_SUPPORT_KOBO=1000000000
MIN_WITHDRAWAL_KOBO=100000
MAX_WITHDRAWAL_KOBO=10000000
MAX_OPEN_WITHDRAWALS=3
WITHDRAWAL_FEE_KOBO=0

# ── Payments provider: flutterwave | mock ────────────────────────────────────
# mock (default in development) serves a local checkout screen and moves no money.
PAYMENTS_PROVIDER=mock
# Required when PAYMENTS_PROVIDER=flutterwave (Flutterwave dashboard → Settings → API):
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENTITY_SID=
FLUTTERWAVE_WEBHOOK_HASH=

# ── Identity verification (KYC): sumsub | mock ──────────────────────────────
# mock (default in development) approves/rejects via a local test endpoint.
KYC_PROVIDER=mock
# Required when KYC_PROVIDER=sumsub (Sumsub dashboard → Dev Space):
SUMSUB_CLIENT_ID=
SUMSUB_CLIENT_SECRET=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_ID=

# ── OTP SMS delivery: http | mock ────────────────────────────────────────────
# mock (default in development) records messages in a local outbox table so
# the flow is testable without a gateway. Production refuses SMS_PROVIDER=mock.
SMS_PROVIDER=mock
# A generic JSON SMS gateway: POST {to, from, message} with a Bearer token.
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=BuyMePap

# ── Advanced (defaults are sensible; override only if you know why) ─────────
SESSION_COOKIE_NAME=buymepap_session
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=buymepap_csrf
PENDING_TTL_SECONDS=900
# Proxy hops whose X-Forwarded-For entries Express may trust for req.ip. 1 is
# right when the only hop is the platform's own load balancer. Behind a Vercel
# rewrite there are two, so set 2 — otherwise every visitor shares Vercel's
# egress address and the per-IP rate limits become one global bucket.
TRUST_PROXY_HOPS=1
BODY_LIMIT=32kb
CURRENCY=NGN
USERNAME_RESERVATION_TTL_SECONDS=604800
MAX_DRAFTS_PER_PHONE=5
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=6
# Sumsub API origin, and the WebSDK script the browser loads. The default
# resolves to <SUMSUB_SDK_URL>/sumsub.websdk.<version>.js; set it to a full
# .../sumsub.websdk.x.y.z.js URL to pin an exact widget build.
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_SDK_URL=https://cdn.sumsub.com/websdk

# ── Ops (optional) ───────────────────────────────────────────────────────────
# Enables /api/admin/* (reconciliation, sweeps) for holders of this token.
ADMIN_TOKEN=
# Multiplies every rate limit (test/dev convenience; keep 1 in production).
RATE_LIMIT_SCALE=1
