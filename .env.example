# Copy to .env and fill in. Everything works without Paystack keys in mock mode.

# Port for the API + production server
PORT=8787

# Secret for signing creator sessions (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Public base URL of the app (used to build Paystack callback URLs)
APP_URL=http://localhost:8787

# Paystack SECRET key (sk_test_... from dashboard.paystack.com).
# Leave empty to run payments in mock mode (no real transactions).
PAYSTACK_SECRET_KEY=
